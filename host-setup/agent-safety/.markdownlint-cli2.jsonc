{
    // The claude-md-safety.md fragment is appended by the installer into ~/.claude/CLAUDE.md.
    // That file already has its own H1, so the fragment intentionally opens at H2.
    // MD041 requires the first line to be a top-level heading, which an appended snippet is not.
    // This nested config affects only this directory.
    "config": {
        "MD041": false
    }
}
