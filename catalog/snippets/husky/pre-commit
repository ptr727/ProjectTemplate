#!/bin/sh
# shellcheck disable=SC1091  # Generated by Husky install, not present at lint time.
. "$(dirname "$0")/_/husky.sh"
set -eu

# Local pre-commit: language formatting/lint, plus the fleet's shared doc gates.
# The doc gates run via hub_fetch_run.py, copied into the repo root, where every downstream repo keeps it.
# It fetches them fresh from ptr727/ProjectTemplate's `main` branch rather than vendoring or pinning them.
# See hub_fetch_run.py's own docstring, and catalog/snippets/husky/README.md, for why.
# Full doc-lint set (Markdown, spelling, workflow YAML, EditorConfig) stays in CI and the VS Code Lint tasks, since those need Docker.

# Git already runs a hook from the top level, but this is belt and braces for an invocation that does not.
# The doc gates below take a relative scan root, which would otherwise resolve against whatever directory the caller stood in.
cd "$(git rev-parse --show-toplevel)" || exit 1

hub_fetch_run="$PWD/hub_fetch_run.py"

# .NET: CSharpier + dotnet format style via Husky.Net.
# Drop this block in a non-.NET repo, rather than guarding it.
# A repo that keeps it declares dotnet required, and a missing tool fails the commit loudly, not silently.
dotnet husky run || exit 1

# Python: ruff format + ruff check + the repo's type checker via uv, native tooling.
# Drop this block in a non-Python repo, for the same reason the .NET block above is unguarded.
uv run ruff format --check || exit 1
uv run ruff check || exit 1
# Swap for `uv run mypy` if this repo's CI runs mypy instead.
uv run pyright || exit 1

# The interpreter is chosen by running the probes spec/host-tools.json declares, in its order.
# Running one rather than testing for a name is the point.
# That is because Git Bash inherits a Windows PATH that can carry a name which fails when run.
if py -3 --version >/dev/null 2>&1; then
    run_py() { py -3 "$@"; }
elif python3 --version >/dev/null 2>&1; then
    run_py() { python3 "$@"; }
else
    echo "pre-commit: neither 'py -3 --version' nor 'python3 --version' ran, so the doc gates did not run." >&2
    exit 1
fi

# The prose gate reads the paths this commit stages, so an unrelated untracked file cannot refuse it.
# The base is HEAD, or MERGE_HEAD on a merge commit, so the lines a merged-in parent brought are not read as added.
# It reads their working-tree content, so a partially staged file is judged on all of its edits.
# A path that is no longer a file is dropped, since the gate refuses a submodule or a deleted path.
# An empty list skips the gate, which given no path would scan the whole tree.
# The inner sh checks for that itself, since GNU xargs runs once on empty input and BSD xargs does not.
# The list goes to a file and is read from there, because a pipeline hides a failure of its first command.
# `--skip-generated` passes over a staged file in a generated tree, as a whole-tree scan does.
# The run_py function is out of reach of xargs, so uv chooses the interpreter, which hub_fetch_run.py needs anyway.
# The pull request gate reads every line the branch changes against its base.
base=HEAD
if git rev-parse -q --verify MERGE_HEAD >/dev/null; then
    base=MERGE_HEAD
fi
staged=$(mktemp) || exit 1
trap 'rm -f "$staged"' EXIT
# Dash runs no EXIT trap on a signal it leaves untrapped, so the two an interrupt sends are trapped.
trap 'echo "pre-commit: interrupted by SIGINT." >&2; exit 130' INT
trap 'echo "pre-commit: interrupted by SIGTERM." >&2; exit 143' TERM
git diff --cached --name-only --diff-filter=ACMRT -z >"$staged" || exit 1
# shellcheck disable=SC2016  # Each expansion belongs to the inner sh.
xargs -0 sh -c 'fetch=$1; base=$2; shift 2; for p do shift; if [ -f "$p" ]; then set -- "$@" "$p"; fi; done
    [ "$#" -eq 0 ] || exec uv run --no-project python "$fetch" .github/actions/prose-gate/prose_lint.py \
        --skip-generated --diff "$base" -- "$@"' sh "$hub_fetch_run" "$base" <"$staged" || exit 1
run_py "$hub_fetch_run" .github/actions/repo-gate/repo_gate.py --check eol || exit 1
