#!/bin/sh
# Local pre-commit gate for this repository: the doc checks CI runs, each at the scope that fits it.
# Enable it per clone with `git config core.hooksPath .husky`.
# A clone carries no hooks path, so this file does nothing until that is set.
# It deliberately does not source `_/husky.sh`.
# That file is gitignored and arrives with an npm install this repository does not have.
# Sourcing it would therefore break the hook in a fresh clone.
#
# The language-formatting half the fleet convention names runs via uvx, matching CI's own invocation for a repo with no `uv.lock` (the Scripts profile, CODESTYLE.md "Two profiles").
#
# `repo_gate.py --check sha-pin` is absent for a different reason.
# It resolves same-owner pins against the GitHub API, and a hook needing a network fails offline.
# The doc linters that need Docker stay in CI and in the VS Code Lint tasks.
set -eu

# Git already runs a hook from the top level, measured by committing from `scripts/` and printing `pwd`.
# This is belt and braces for an invocation that does not come from git.
# The relative paths below would otherwise resolve against whatever directory the caller was in.
cd "$(git rev-parse --show-toplevel)"

# An interrupt stops the running tool, removes the list file, and re-raises the signal, per CODESTYLE.md "Interrupts in Shell".
# This is POSIX sh, so the trap removes the file itself, since dash runs no EXIT trap when the re-raised signal ends it.
staged=""
child=""
interrupted() {
    if [ -n "$child" ]; then
        kill "$child" 2>/dev/null || :
        wait "$child" || :
    fi
    if [ -n "$staged" ]; then
        rm -f "$staged"
    fi
    echo "pre-commit: interrupted by SIG$1." >&2
    trap - "$1"
    kill -s "$1" "$$"
}
trap 'if [ -n "$staged" ]; then rm -f "$staged"; fi' EXIT
trap 'interrupted INT; exit 130' INT
trap 'interrupted TERM; exit 143' TERM

# The Python step runs in the background and is waited for, since a trap runs only once a foreground command returns.
# The trap stops it with SIGTERM, because a background child ignores SIGINT.
# A launcher such as uvx, uv run, or dotnet stays in the foreground, so a Ctrl-C reaches the tool it starts.
# In the background that tool would ignore SIGINT, and the trap's SIGTERM would reach it only through a launcher that forwards it.
run_child() {
    "$@" &
    child=$!
    status=0
    wait "$child" || status=$?
    child=""
    return "$status"
}

# Ruff and mypy, via uvx per this repo's own CI invocation for a repo with no `uv.lock`.
# Ruff runs the version CI pins, taking the manifest the validator reads as a requirement.
uvx --with-requirements .github/actions/python-tool-pins/requirements.txt ruff format --check .
uvx --with-requirements .github/actions/python-tool-pins/requirements.txt ruff check .
uvx mypy@latest

# The interpreter is chosen by running the probes spec/host-tools.json declares, in its order.
# Running one rather than testing for a name is the point.
# That is because Git Bash inherits a Windows PATH that can carry a name which fails when run.
if py -3 --version >/dev/null 2>&1; then
    run_py() { run_child py -3 "$@"; }
elif python3 --version >/dev/null 2>&1; then
    run_py() { run_child python3 "$@"; }
else
    echo "pre-commit: neither 'py -3 --version' nor 'python3 --version' ran, so the doc gates did not run." >&2
    echo "pre-commit: see docs/host-setup.md 'What a Host Must Provide'." >&2
    exit 1
fi

# The prose gate is scoped to what changed, which is the policy for prose.
# `--diff-commit` has the gate diff against HEAD, or MERGE_HEAD on a merge commit, so the lines a merged-in parent brought are not read as added.
# A rule is applied as a file is next edited rather than swept across the tree.
# Whole-tree costs about 2.2 seconds where the diff-scoped run costs about 0.15.
# The gate reads the paths this commit stages, so an unrelated untracked file cannot refuse it.
# It reads their working-tree content, so a partially staged file is judged on all of its edits.
# A path that is no longer a file is dropped, since the gate refuses a submodule or a deleted path.
# An empty list skips the gate, which given no path would scan the whole tree.
# The inner sh checks for that itself, since GNU xargs runs once on empty input and BSD xargs does not.
# The list goes to a file and is read from there, because a pipeline hides a failure of its first command.
# `--skip-generated` passes over a staged file in a generated tree, as a whole-tree scan does.
# The pull request gate reads every line the branch changes against its base.
# The xargs call runs in the foreground, since a signal sent to xargs alone would not reach the gate it starts.
staged=$(mktemp)
git diff --cached --name-only --diff-filter=ACMRT -z >"$staged"
# shellcheck disable=SC2016  # Each expansion belongs to the inner sh.
xargs -0 sh -c 'for p do shift; if [ -f "$p" ]; then set -- "$@" "$p"; fi; done
    [ "$#" -eq 0 ] || exec uv run --no-project --script .github/actions/prose-gate/prose_lint.py \
        --skip-generated --diff-commit -- "$@"' sh <"$staged"

# The eol check is repo-wide rather than diff-scoped, and it is here because it is already fast.
# It reads `.gitattributes` against `.editorconfig` for the whole repository and takes no file list.
# At about 0.04 seconds there is nothing to scope, so scoping it would only make it wrong.
run_py scripts/repo_gate.py --check eol
