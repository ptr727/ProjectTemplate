        { "path": "repo-config/develop.json", "fidelity": "verbatim", "whole": true, "appliesTo": ["release"] },
        { "path": "repo-config/operational/develop.json", "fidelity": "verbatim", "whole": true, "appliesTo": ["operational"] },
        { "path": "repo-config/main.json", "fidelity": "verbatim", "whole": true, "appliesTo": "*" },
        { "path": "repo-config/README.md", "fidelity": "intent", "whole": true, "intentRef": "repo-config/README.md", "appliesTo": "*" },
        { "path": "repo-config/configure.sh", "fidelity": "verbatim", "whole": true, "appliesTo": "*" },
